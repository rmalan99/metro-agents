{
  "$schema": "https://opencode.ai/config.json",
  // Fallback seguro si la extensión no carga o la orquestación está desactivada.
  "default_agent": "build",
  "tool_output": {
    // Evita incorporar logs, catálogos o respuestas API completas al contexto.
    "max_lines": 300,
    "max_bytes": 20000,
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8000,
    },
    "buffer": "20%",
  },
  "plugins": [
    {
      "package": "./.opencode/extensions/governance-gate",
      "options": {
        "orchestration": {
          // Cambia a false para trabajar con el agente primario directo.
          "enabled": true,
          "directAgent": "build",
        },
      },
    },
  ],
}
