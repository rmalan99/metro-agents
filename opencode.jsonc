{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "subagent_depth": 2,
  "share": "manual",
  "agent": {
    "orchestrator": {
      "description": "Primary coordinator. Refines requirements, creates team work orders, controls delivery gates, and never writes code.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "prompt": "{file:./.opencode/prompts/orchestrator.md}",
      "permission": {
        "read": {
          "*": "deny",
          ".opencode/skills/hierarchical-software-delivery/references/roles/orchestrator.md": "allow",
          "*/.opencode/skills/hierarchical-software-delivery/references/roles/orchestrator.md": "allow",
          ".opencode/skills/hierarchical-software-delivery/references/quality.md": "allow",
          "*/.opencode/skills/hierarchical-software-delivery/references/quality.md": "allow",
