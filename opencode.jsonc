          ".opencode/skills/hierarchical-software-delivery/references/schemas/lead-review.md": "allow",
          "*/.opencode/skills/hierarchical-software-delivery/references/schemas/lead-review.md": "allow",
          ".opencode/skills/hierarchical-software-delivery/references/schemas/quality-summary.md": "allow",
          "*/.opencode/skills/hierarchical-software-delivery/references/schemas/quality-summary.md": "allow",
          ".opencode/skills/hierarchical-software-delivery/references/schemas/validation-evidence.md": "allow",
          "*/.opencode/skills/hierarchical-software-delivery/references/schemas/validation-evidence.md": "allow",
          ".opencode/skills/hierarchical-software-delivery/references/schemas/qa-result.md": "allow",
          "*/.opencode/skills/hierarchical-software-delivery/references/schemas/qa-result.md": "allow",
          ".opencode/logs/error-log.md": "allow",
          "*/.opencode/logs/error-log.md": "allow",
