          "*/.opencode/skills/hierarchical-software-delivery/references/schemas/defect.md": "allow"
        },
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "bash": "deny",
        "lsp": "deny",
        "external_directory": "deny",
        "question": "allow",
        "skill": {
          "*": "deny",
          "hierarchical-software-delivery": "allow"
        },
        "task": {
          "*": "deny",
          "evaluator": "allow",
          "frontend-lead": "allow",
          "backend-lead": "allow",
          "qa-lead": "allow",
          "error-logger": "allow"
        }
      }
    },
    "evaluator": {
      "description": "Refines raw requirements into precise, testable requirements without designing implementation.",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "prompt": "{file:./.opencode/prompts/evaluator.md}",
