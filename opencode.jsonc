          "react-state-management": "allow",
          "react-testing-quality-workflow": "allow",
          "frontend-forms": "allow"
        }
      }
    },
    "frontend-junior": {
      "description": "Frontend execution worker. Executes exactly one explicit task, validates it, reports it, and stops.",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "prompt": "{file:./.opencode/prompts/frontend-junior.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "external_directory": "deny",
        "question": "deny",
        "task": "deny",
        "bash": {
          "*": "allow",
          "python3 .opencode/tools/append-error-log.py": "deny",
          "python3 .opencode/tools/append-error-log.py *": "deny",
          "git push*": "deny",
          "git commit*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny",
          "rm -rf *": "deny"
