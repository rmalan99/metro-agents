    "frontend-lead": {
      "description": "Senior frontend lead. Inspects, plans, delegates, and reviews. Never edits code.",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "prompt": "{file:./.opencode/prompts/frontend-lead.md}",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "external_directory": "deny",
        "question": "deny",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "git log *": "allow"
        },
        "task": {
          "*": "deny",
          "frontend-junior": "allow",
          "error-logger": "allow"
        },
        "skill": {
          "*": "deny",
          "hierarchical-software-delivery": "allow",
